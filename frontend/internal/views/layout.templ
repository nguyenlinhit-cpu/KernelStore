package views

import "github.com/KernelStore/frontend/internal/i18n"

// Layout = index.html + App (header, menu, toast host, main).
templ Layout() {
	<!DOCTYPE html>
	<html lang={ i18n.FromContext(ctx).Code() }>
		<head>
			<meta charset="utf-8"/>
			<meta name="viewport" content="width=device-width, initial-scale=1.0"/>
			<title>KernelStore — premium tech marketplace</title>
			<meta name="theme-color" content="#05070a"/>
			<link rel="icon" type="image/svg+xml" href="/static/favicon.svg"/>
			<link rel="preconnect" href="https://fonts.googleapis.com"/>
			<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
			<link href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500;600;700;800&display=swap" rel="stylesheet"/>
			<link rel="stylesheet" href="/static/css/app.css"/>
			<script src="/static/js/htmx.min.js"></script>
			<script src="/static/js/app.js" defer></script>
		</head>
		<body hx-boost="true">
			<!-- ambient terminal backdrop: faint circuit grid + neon aurora + scanline -->
			<div class="app-bg" aria-hidden="true">
				<div class="app-bg-grid"></div>
				<div class="app-bg-aurora"></div>
				<div class="app-bg-scan"></div>
			</div>
			<div class="min-h-screen flex flex-col">
				@Header()
				@NavMenu()
				@ToastHost()
				<main class="flex-1">
					{ children... }
				</main>
			</div>
		</body>
	</html>
}

templ Header() {
	<header class="glass sticky top-0 z-40 border-b border-[var(--border)] px-4 py-3 flex flex-wrap justify-between items-center gap-2 text-sm relative">
		<a href="/" class="font-extrabold text-base tracking-tight flex items-center gap-1.5">
			<span class="text-[var(--accent)] neon">❯</span>
			<span class="glow-text">KernelStore</span>
			<span class="text-[var(--fg-muted)] font-medium text-xs">v0.1.0</span>
			<span class="caret text-[var(--accent)] font-normal">_</span>
		</a>
		<div class="hairline-accent absolute left-0 bottom-0 h-px w-full"></div>
		<div class="flex flex-wrap items-center gap-2 sm:gap-3">
			<button class="term-btn px-2 py-0.5 text-xs" title="switch language / đổi ngôn ngữ" hx-post="/lang" hx-swap="none">
				{ i18n.FromContext(ctx).Label() }
			</button>
			if u := currentUser(ctx); u != nil {
				<span class="hidden sm:inline text-[var(--fg-muted)]">{ u.UserName + " (" + u.Role + "):" }</span>
				<button class="term-btn px-2 py-0.5 text-xs" hx-post="/auth/logout" hx-swap="none">{ t(ctx, "header.logout") }</button>
			} else {
				<div class="flex items-center gap-2 sm:gap-3">
					<span class="hidden sm:inline text-[var(--fg-muted)]">{ t(ctx, "header.guest") }</span>
					<a href="/products" class="term-btn px-2 py-0.5 text-xs">{ t(ctx, "header.browse") }</a>
					<a href="/auth/login" class="term-btn px-2 py-0.5 text-xs">{ t(ctx, "header.login") }</a>
					<a href="/auth/register" class="term-btn px-2 py-0.5 text-xs">{ t(ctx, "header.register") }</a>
				</div>
			}
		</div>
	</header>
}

// NavMenu: menu theo vai trò, chỉ hiện khi đã đăng nhập; tô sáng mục đang mở.
templ NavMenu() {
	if u := currentUser(ctx); u != nil {
		{{ s := SessionFrom(ctx) }}
		{{ groups := menuGroups(u.Role) }}
		<nav class="glass border-b border-[var(--border)] px-4 py-2 flex items-center gap-1.5 text-xs overflow-x-auto whitespace-nowrap">
			<a href="/" class={ menuClass(s.Path == "/") }>{ t(ctx, "nav.home") }</a>
			for gi, g := range groups {
				<span class="term-muted shrink-0 ml-2">{ t(ctx, g.label) + ":" }</span>
				for _, it := range g.items {
					<a href={ templ.SafeURL(it.href) } class={ menuClass(isActive(it.href, s.Path, s.Tab)) }>{ t(ctx, it.label) }</a>
				}
				if gi != len(groups)-1 {
					<span class="term-muted shrink-0 mx-1">│</span>
				}
			}
		</nav>
	}
}

// ToastHost: khung chứa toast góc dưới phải; app.js thêm toast khi nhận sự kiện "ks-toast".
templ ToastHost() {
	<div id="toasts" hx-preserve="true" class="fixed bottom-4 right-4 z-50 flex flex-col gap-2 w-80 max-w-[calc(100vw-2rem)]"></div>
}

// Loading: chữ hiện dần kiểu máy đánh chữ + con trỏ nhấp nháy.
templ Loading(text string) {
	<span class="term-typing term-muted" style={ templ.SafeCSS(loadingStyle(text)) }>{ text }</span>
}

// KernelPanic: khung lỗi kiểu "kernel panic" cho 404 / 500.
templ KernelPanic(code, title, detail, backHref, backLabel string) {
	<div class="max-w-2xl mx-auto p-6">
		<div class="term-box p-6">
			<p class="term-error text-sm mb-3">{ "--- KERNEL PANIC: " + code + " ---" }</p>
			<p class="text-[var(--fg-primary)] font-bold mb-3">{ title }</p>
			<pre class="term-muted text-xs whitespace-pre-wrap leading-relaxed">{ panicTrace(ctx, code, detail) }</pre>
			<a href={ templ.SafeURL(orStr(backHref, "/")) } class="term-btn inline-block mt-4 px-4 py-2 text-sm">{ orStr(backLabel, "$ cd /") }</a>
		</div>
	</div>
}

// TermInput: ô nhập kiểu terminal (nhãn + dấu ">" + input; ô mật khẩu có nút ẩn/hiện).
templ TermInput(id, name, label, inputType, placeholder, value string, attrs templ.Attributes) {
	<label for={ id } class="block mb-1 text-xs term-muted">{ label }</label>
	<div class="flex items-center gap-2 mb-3">
		<span class="term-info text-sm shrink-0">&gt;</span>
		<input id={ id } name={ name } type={ orStr(inputType, "text") } placeholder={ placeholder } value={ value } class="term-input w-full px-3 py-2 text-sm" { attrs... }/>
		if inputType == "password" {
			<button type="button" class="term-btn px-2 py-2 shrink-0 flex items-center justify-center" aria-label="toggle password visibility" title="hiện mật khẩu" data-toggle-password={ id }>
				<svg class="eye" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M1 12s4-8 11-8 11 8 11 8-4 8-11 8-11-8-11-8z"></path>
					<circle cx="12" cy="12" r="3"></circle>
				</svg>
				<svg class="eye-off hidden" xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"></path>
					<line x1="1" y1="1" x2="23" y2="23"></line>
				</svg>
			</button>
		}
	</div>
}

// ErrorLine: dòng "[ERROR] ..." giữ chỗ (invisible khi rỗng) như class:invisible của Leptos.
templ ErrorLine(msg, extraClass string) {
	<p class={ "term-error text-sm mb-2", extraClass, templ.KV("invisible", msg == "") }>{ "[ERROR] " + msg }</p>
}

// BusyLabel: chữ đổi khi request HTMX đang chạy (thay cho signal is_loading của Leptos).
templ BusyLabel(idle, busy string) {
	<span class="when-idle">{ idle }</span>
	<span class="when-busy">{ busy }</span>
}
