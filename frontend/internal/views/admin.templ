package views

import (
	"strings"

	"github.com/KernelStore/frontend/internal/client"
)

var adminTabs = []string{"dashboard", "shops", "categories"}

var adminShopFilters = []string{"All", "Pending", "Approved", "Rejected", "Banned", "Deleted"}

templ AdminPage(tab string, body templ.Component) {
	<div class="max-w-4xl mx-auto p-6">
		<p class="term-muted text-sm mb-1">$ kernelstore --admin</p>
		<h1 class="text-lg font-bold mb-4">{ t(ctx, "admin.title") }</h1>
		<div class="flex gap-2 mb-6 text-sm border-b border-[var(--border)] pb-2">
			for _, tb := range adminTabs {
				<a href={ templ.SafeURL("/admin?tab=" + tb) } class={ "term-btn px-3 py-1 text-xs", templ.KV("term-active", tab == tb) }>{ t(ctx, "admin.tab." + tb) }</a>
			}
		</div>
		@body
	</div>
}

templ AdminDashboard(s *client.DashboardStats, errMsg string) {
	if errMsg != "" {
		<p class="term-error text-sm mb-3">{ "[ERROR] " + errMsg }</p>
		<p class="term-error">{ t(ctx, "admin.dash_failed") }</p>
	} else {
		<div class="grid grid-cols-2 sm:grid-cols-4 gap-3 mb-6">
			@StatCard(t(ctx, "admin.stat.users"), itoa(s.TotalUsers))
			@StatCard(t(ctx, "admin.stat.shops"), itoa(s.TotalShops))
			@StatCard(t(ctx, "admin.stat.products"), itoa(s.TotalProducts))
			@StatCard(t(ctx, "admin.stat.orders"), itoa(s.TotalOrders))
		</div>
		<div class="term-box p-4 mb-6">
			<p class="term-muted text-xs mb-1">{ t(ctx, "admin.revenue") }</p>
			<p class="text-2xl font-bold text-[var(--fg-primary)]">{ money(s.TotalRevenue) }</p>
		</div>
		<div class="term-box p-4 mb-6 font-mono text-sm overflow-x-auto">
			<p class="term-muted text-xs mb-3">{ t(ctx, "admin.monitor") }</p>
			@MeterRow(t(ctx, "admin.shops_approved"), s.ApprovedShops, s.TotalShops)
			@MeterRow(t(ctx, "admin.shops_pending"), s.PendingShops, s.TotalShops)
			@MeterRow(t(ctx, "admin.products_live"), s.ActiveProducts, s.TotalProducts)
		</div>
		<div class="term-box p-4 font-mono text-sm overflow-x-auto">
			<p class="term-muted text-xs mb-3">{ t(ctx, "admin.orders_by_status") }</p>
			@StatusMeters(s.OrdersByStatus)
		</div>
	}
}

templ StatCard(label, value string) {
	<div class="term-box p-3">
		<p class="term-muted text-xs">{ label }</p>
		<p class="text-xl font-bold text-[var(--fg-primary)]">{ value }</p>
	</div>
}

templ MeterRow(label string, value, maxV int) {
	<div class="flex items-center gap-2 mb-1">
		<span class="term-muted w-32">{ label }</span>
		<span class="term-info">{ meter(value, maxV, 16) }</span>
		<span class="term-muted w-20 text-right">{ itoa(value) + "/" + itoa(maxV) + " " + itoa(pct(value, maxV)) + "%" }</span>
	</div>
}

// StatusMeters: biểu đồ ASCII số đơn theo trạng thái (dùng cho admin và seller).
templ StatusMeters(counts []client.OrderStatusCount) {
	{{ maxCount := 0 }}
	for _, o := range counts {
		{{ maxCount = max(maxCount, o.Count) }}
	}
	for _, o := range counts {
		<div class="flex items-center gap-2 mb-1">
			<span class="term-muted w-24">{ padRight(o.Status, 10) }</span>
			<span class="term-info">{ meter(o.Count, maxCount, 16) }</span>
			<span class="term-muted w-8 text-right">{ itoa(o.Count) }</span>
		</div>
	}
}

// ShopModerationVM: trạng thái khung duyệt shop.
type ShopModerationVM struct {
	Filter    string // "All" hoặc tên trạng thái
	Shops     []client.ShopInfo
	Error     string
	Flash     string
	RowErrors map[string]string // shopID → lỗi của dòng đó
}

templ ShopModeration(vm ShopModerationVM) {
	<div id="shop-moderation" hx-target="this" hx-swap="outerHTML" hx-sync="this:drop">
		<h2 class="text-base font-bold mb-3">{ t(ctx, "admin.moderation") }</h2>
		<div class="flex gap-2 mb-4 text-sm">
			for _, f := range adminShopFilters {
				<a href={ templ.SafeURL("/admin?tab=shops&status=" + f) } class={ "term-btn px-3 py-1 text-xs", templ.KV("term-active", vm.Filter == f) }>{ t(ctx, "admin.f." + strings.ToLower(f)) }</a>
			}
		</div>
		if vm.Flash != "" {
			<p class="term-info text-sm mb-2">{ "[OK] " + vm.Flash }</p>
		}
		@ErrorLine(vm.Error, "")
		if len(vm.Shops) == 0 {
			<p class="term-muted">{ t(ctx, "admin.no_shops") }</p>
		} else {
			<p class="term-muted text-xs mb-2">{ t(ctx, "admin.showing_shops") + itoa(len(vm.Shops)) + t(ctx, "admin.shop_word") }</p>
			<div class="flex flex-col gap-3">
				for i := range vm.Shops {
					@AdminShopRow(&vm.Shops[i], vm.Filter, vm.RowErrors[vm.Shops[i].ID])
				}
			</div>
		}
	</div>
}

templ AdminShopRow(s *client.ShopInfo, filter, rowErr string) {
	{{ vals := jsonAttr(map[string]string{"filter": filter, "name": s.Name}) }}
	{{ base := "/x/admin/shops/" + s.ID }}
	<div class="term-box p-4 flex justify-between items-start gap-4">
		<div class="min-w-0">
			<h3 class="font-bold text-[var(--fg-primary)]">{ s.Name }</h3>
			<p class="term-muted text-xs mt-0.5">{ "slug: " + s.Slug + t(ctx, "admin.owner") + s.OwnerName }</p>
			<p class="text-sm mt-1 break-words">{ s.Description }</p>
			<p class="mt-2 text-xs"><span class={ shopBadge(s.Status) }>{ "[" + s.Status + "]" }</span></p>
			<p class={ "term-error text-xs mt-1", templ.KV("invisible", rowErr == "") }>{ rowErr }</p>
		</div>
		<div class="flex gap-2 shrink-0 flex-wrap justify-end" hx-vals={ vals } hx-disabled-elt="this">
			if s.Status == "Pending" {
				<button class="term-btn px-3 py-1 text-xs" hx-post={ base + "/approve" }>{ t(ctx, "admin.approve") }</button>
				<button class="term-btn px-3 py-1 text-xs" hx-post={ base + "/reject" }>{ t(ctx, "admin.reject") }</button>
			}
			if s.Status == "Approved" || s.Status == "Rejected" {
				<button class="term-btn px-3 py-1 text-xs term-warn" hx-post={ base + "/ban" }>{ t(ctx, "admin.ban") }</button>
			}
			if s.Status == "Banned" {
				<button class="term-btn px-3 py-1 text-xs" hx-post={ base + "/unban" }>{ t(ctx, "admin.unban") }</button>
			}
			if s.Status != "Deleted" {
				<button class="term-btn px-3 py-1 text-xs term-error" hx-post={ base + "/delete" } hx-confirm={ tf(ctx, "admin.del_confirm", s.Name) }>{ t(ctx, "admin.delete_shop") }</button>
			}
		</div>
	</div>
}

// CategoryFormState: form tạo/sửa category (dùng chung admin và seller).
type CategoryFormState struct {
	EditID, Name, Slug, Description, ParentID string
}

// CategoryMgmtVM: khung quản lý category của admin.
type CategoryMgmtVM struct {
	Tree    []client.CategoryNode
	Form    CategoryFormState
	Flash   string
	Error   string
	LoadErr string
}

templ CategoryManagement(vm CategoryMgmtVM) {
	{{ rows := Flatten(vm.Tree) }}
	<div id="category-mgmt" hx-target="this" hx-swap="outerHTML">
		<h2 class="text-base font-bold mb-3">{ t(ctx, "admin.cat_mgmt") }</h2>
		if vm.Flash != "" {
			<p class="term-info text-sm mb-2">{ "[OK] " + vm.Flash }</p>
		}
		if vm.Error != "" {
			<p class="term-error text-sm mb-2">{ "[ERROR] " + vm.Error }</p>
		}
		<form class="term-box p-4 mb-6" hx-post="/x/admin/categories" hx-disabled-elt="find button[type=submit]" data-slugify>
			<input type="hidden" name="id" value={ vm.Form.EditID }/>
			<p class="term-muted text-xs mb-3">
				if vm.Form.EditID != "" {
					{ t(ctx, "admin.edit_cat") }
				} else {
					{ t(ctx, "admin.new_cat") }
				}
			</p>
			<div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
				<div>
					<label class="block mb-1 text-xs term-muted">{ t(ctx, "common.name") }</label>
					<input name="name" class="term-input w-full px-3 py-2 text-sm" value={ vm.Form.Name } data-slug-source/>
				</div>
				<div>
					<label class="block mb-1 text-xs term-muted">{ t(ctx, "common.slug") }</label>
					<input name="slug" class="term-input w-full px-3 py-2 text-sm" value={ vm.Form.Slug } data-slug-target data-slug-auto={ boolStr(vm.Form.EditID == "") }/>
				</div>
				<div>
					<label class="block mb-1 text-xs term-muted">{ t(ctx, "admin.parent") }</label>
					<select name="parentId" class="term-input w-full px-3 py-2 text-sm">
						<option value="">{ t(ctx, "admin.root_option") }</option>
						for _, fc := range rows {
							if fc.Node.ID != vm.Form.EditID {
								<option value={ fc.Node.ID } selected?={ fc.Node.ID == vm.Form.ParentID }>{ strings.Repeat("  ", fc.Depth) + fc.Node.Name }</option>
							}
						}
					</select>
				</div>
				<div>
					<label class="block mb-1 text-xs term-muted">{ t(ctx, "common.description") }</label>
					<input name="description" class="term-input w-full px-3 py-2 text-sm" value={ vm.Form.Description }/>
				</div>
			</div>
			<div class="flex gap-2 mt-3">
				<button type="submit" class="term-btn px-4 py-1.5 text-sm">
					if vm.Form.EditID != "" {
						@BusyLabel(t(ctx, "common.update"), t(ctx, "common.saving"))
					} else {
						@BusyLabel(t(ctx, "common.create"), t(ctx, "common.saving"))
					}
				</button>
				if vm.Form.EditID != "" {
					<button type="button" class="term-btn px-4 py-1.5 text-sm" hx-get="/x/admin/categories">{ t(ctx, "common.cancel") }</button>
				}
			</div>
		</form>
		if vm.LoadErr != "" {
			<p class="term-error text-sm">{ vm.LoadErr }</p>
		} else if len(rows) == 0 {
			<p class="term-muted">{ t(ctx, "admin.no_cats") }</p>
		} else {
			<div class="term-box overflow-hidden">
				for _, fc := range rows {
					<div class="flex items-center justify-between gap-3 px-4 py-2 border-b border-[var(--border)] last:border-0">
						<div class="min-w-0 font-mono text-sm">
							<span class="term-muted">{ strings.Repeat("  ", fc.Depth) + "└ " }</span>
							<span class="text-[var(--fg-primary)]">{ fc.Node.Name }</span>
							<span class="term-muted text-xs">{ "  /" + fc.Node.Slug + "  (" + itoa(fc.Node.ProductCount) + t(ctx, "admin.products_count") }</span>
						</div>
						<div class="flex gap-2 shrink-0">
							<button class="term-btn px-2 py-0.5 text-xs" hx-get={ "/x/admin/categories?edit=" + fc.Node.ID }>{ t(ctx, "common.edit") }</button>
							<button class="term-btn px-2 py-0.5 text-xs text-[var(--fg-error)]" hx-post={ "/x/admin/categories/" + fc.Node.ID + "/delete" } hx-vals={ jsonAttr(map[string]string{"name": fc.Node.Name}) }>{ t(ctx, "common.del") }</button>
						</div>
					</div>
				}
			</div>
		}
	</div>
}
