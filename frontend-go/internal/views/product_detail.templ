package views

import (
	"fmt"

	"github.com/KernelStore/frontend-go/internal/client"
)

templ ProductDetailPage(p *client.ProductDetail) {
	<div class="p-6 max-w-6xl mx-auto">
		@ProductView(p)
	</div>
}

templ ProductNotFound(code, title, detail string) {
	<div class="p-6 max-w-6xl mx-auto">
		@KernelPanic(code, title, detail, "/products", t(ctx, "pd.back_products"))
	</div>
}

templ ProductView(p *client.ProductDetail) {
	{{ category := orDefault(p.CategoryName, t(ctx, "products.uncategorized")) }}
	{{ inStock := p.StockQuantity > 0 }}
	{{ primary := client.PrimaryImage(p.Images) }}
	<p class="term-muted text-xs mb-4">
		{ "~/products/" + category + "/" + p.Slug }
		<span class="caret">_</span>
	</p>
	<div class="grid grid-cols-1 lg:grid-cols-2 gap-8">
		<div data-gallery>
			<div class="term-box aspect-square overflow-hidden flex items-center justify-center bg-[var(--bg-tertiary)]">
				if primary == "" {
					<span class="term-muted text-6xl">[ ]</span>
				} else {
					<img src={ primary } class="w-full h-full object-cover" data-gallery-main/>
				}
			</div>
			if len(p.Images) > 1 {
				<div class="flex gap-2 mt-3 flex-wrap">
					for _, img := range p.Images {
						<button type="button" class={ "term-box w-16 h-16 overflow-hidden", templ.KV("term-active", img.Url == primary) } data-gallery-src={ img.Url }>
							<img src={ img.Url } class="w-full h-full object-cover"/>
						</button>
					}
				</div>
			}
		</div>
		<div class="space-y-4">
			<p class="term-info text-xs">{ category }</p>
			<h1 class="text-2xl font-bold text-[var(--fg-primary)]">{ p.Name }</h1>
			<div class="flex items-center gap-2 text-sm">
				<span class="term-warn">{ stars(roundStars(p.AverageRating)) }</span>
				<span class="term-muted">{ fmt.Sprintf("%.1f (%d %s)", p.AverageRating, p.ReviewCount, reviewsWord(ctx, p.ReviewCount)) }</span>
			</div>
			<div class="flex items-baseline gap-3">
				<span class="text-3xl font-bold text-[var(--fg-primary)]">{ money(effectivePrice(&p.Product)) }</span>
				if p.SalePrice != nil {
					<span class="text-lg line-through term-muted">{ money(p.Price) }</span>
					<span class="term-active px-2 py-0.5 text-xs">SALE</span>
				}
			</div>
			<div class="text-sm space-y-1">
				<p>
					<span class="term-muted">{ t(ctx, "pd.stock") }</span>
					if inStock {
						<span class="text-[var(--fg-primary)]">{ itoa(p.StockQuantity) + " " + t(ctx, "pd.available") }</span>
					} else {
						<span class="term-error">{ t(ctx, "pd.out_of_stock") }</span>
					}
				</p>
				<p><span class="term-muted">{ t(ctx, "pd.sku") }</span><span>{ p.Sku }</span></p>
				<p>
					<span class="term-muted">{ t(ctx, "pd.warranty") }</span>
					if p.WarrantyMonths > 0 {
						<span class="text-[var(--fg-primary)]">{ itoa(p.WarrantyMonths) + " " + t(ctx, "pd.warranty_months") }</span>
					} else {
						<span class="term-muted">{ t(ctx, "pd.no_warranty") }</span>
					}
				</p>
				<p>
					<span class="term-muted">{ t(ctx, "pd.sold_by") }</span>
					<a href={ templ.SafeURL("/products?shop=" + p.Shop.Slug) } class="term-info hover:underline">{ p.Shop.Name }</a>
				</p>
			</div>
			<div class="pt-2">
				<button
					class="term-btn px-6 py-2 text-sm"
					disabled?={ !inStock }
					hx-post="/x/cart/add"
					hx-vals={ jsonAttr(map[string]string{"productId": p.ID}) }
					hx-target="#cart-flash"
					hx-swap="innerHTML"
					hx-disabled-elt="this"
				>
					if !inStock {
						{ t(ctx, "pd.unavailable") }
					} else {
						@BusyLabel(t(ctx, "pd.add_to_cart"), t(ctx, "pd.adding"))
					}
				</button>
				<div id="cart-flash"></div>
			</div>
			<div class="term-sub p-3 mt-4">
				<p class="term-muted text-xs mb-1">{ t(ctx, "pd.description") }</p>
				<p class="text-sm whitespace-pre-wrap">{ p.Description }</p>
			</div>
		</div>
	</div>
	<div class="term-box p-4 mt-8 flex items-center justify-between gap-4">
		<div>
			<p class="text-xs term-muted mb-1">{ t(ctx, "pd.shop") }</p>
			<p class="text-[var(--fg-primary)] font-bold">{ p.Shop.Name }</p>
			<p class="term-muted text-xs mt-1">
				{ itoa(p.Shop.ProductCount) + " " + t(ctx, "common.products") }
				if p.Shop.Description != "" {
					{ " · " + p.Shop.Description }
				}
			</p>
		</div>
		<div class="flex gap-2">
			<button class="term-btn px-4 py-2 text-sm shrink-0" hx-post="/x/chat/start" hx-vals={ jsonAttr(map[string]string{"shopId": p.Shop.ID}) } hx-swap="none">
				{ t(ctx, "pd.chat_seller") }
			</button>
			<a href={ templ.SafeURL("/products?shop=" + p.Shop.Slug) } class="term-btn px-4 py-2 text-sm shrink-0">{ t(ctx, "pd.view_shop") }</a>
		</div>
	</div>
	<div class="mt-8" hx-get={ "/x/products/" + p.ID + "/reviews" } hx-trigger="load" hx-swap="innerHTML">
		<p class="text-sm py-4">
			@Loading(t(ctx, "pd.loading_reviews"))
		</p>
	</div>
}

// CartFlash: dòng thông báo dưới nút "thêm vào giỏ".
templ CartFlash(msg string) {
	<p class="term-warn text-xs mt-2">{ msg }</p>
}

templ Reviews(r *client.ProductReviews, errMsg string) {
	if errMsg != "" {
		<p class="term-error text-sm">{ t(ctx, "pd.reviews_failed") } { errMsg }</p>
	} else {
		<h2 class="text-lg font-bold mb-4">
			{ t(ctx, "pd.reviews") }
			<span class="term-muted text-sm">{ "(" + itoa(r.ReviewCount) + ")" }</span>
		</h2>
		if r.ReviewCount > 0 {
			{{ dist := ratingDistribution(r.Reviews) }}
			{{ total := max(len(r.Reviews), 1) }}
			<div class="term-box p-4 mb-4 flex flex-col sm:flex-row gap-6">
				<div class="text-center shrink-0">
					<p class="text-3xl font-bold text-[var(--fg-primary)]">{ fmt.Sprintf("%.1f", r.AverageRating) }</p>
					<p class="term-warn text-sm">{ stars(roundStars(r.AverageRating)) }</p>
					<p class="term-muted text-xs mt-1">{ itoa(r.ReviewCount) + " " + t(ctx, "pd.ratings") }</p>
				</div>
				<div class="flex-1 space-y-1">
					for star := 5; star >= 1; star-- {
						<div class="flex items-center gap-2 text-xs">
							<span class="term-muted w-6">{ itoa(star) + "★" }</span>
							<span class="term-info font-mono">{ bar(float64(dist[star-1]) / float64(total)) }</span>
							<span class="term-muted w-6 text-right">{ itoa(dist[star-1]) }</span>
						</div>
					}
				</div>
			</div>
		}
		if len(r.Reviews) == 0 {
			<p class="term-muted text-sm">{ t(ctx, "pd.no_reviews") }</p>
		} else {
			<div class="space-y-3">
				for _, rv := range r.Reviews {
					<div class="term-row p-3">
						<div class="flex items-center justify-between mb-1">
							<div class="flex items-center gap-2">
								<span class="text-[var(--fg-primary)] text-sm">{ rv.UserName }</span>
								<span class="term-warn text-sm">{ stars(rv.Rating) }</span>
							</div>
							<span class="term-muted text-xs">{ shortDate(rv.CreatedAt) }</span>
						</div>
						<p class="text-sm term-muted">{ rv.Comment }</p>
					</div>
				}
			</div>
		}
	}
}
